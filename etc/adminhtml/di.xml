<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- the identity and item name are kept from Swissup_Breeze, so older Breeze versions don't duplicate the message -->
    <type name="Magento\Framework\Notification\MessageList">
        <arguments>
            <argument name="messages" xsi:type="array">
                <item name="swissup_breeze_performance" xsi:type="string">Swissup\Core\Model\System\Message\Performance</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\AdminNotification\Model\System\Message\CacheOutdated">
        <plugin name="swissup_core" type="Swissup\Core\Plugin\CacheOutdatedMessage" />
    </type>
</config>
