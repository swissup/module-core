<?php
/** @var \Swissup\Core\Block\Adminhtml\OutdatedBadge $block */
$count = $block->getCount();
$securityCount = $block->getSecurityCount();
$pagespeedCount = $block->getPageSpeedCount();
$counts = array_filter([
    'outdated' => $count,
    'security' => $securityCount,
    'pagespeed' => $pagespeedCount,
    'total' => $count + $securityCount + $pagespeedCount,
]);
?>
<?php if ($counts): ?>
<style id="swissup-outdated-badge-style">
    :root {
        <?php foreach ($counts as $name => $value): ?>
        --swissup-<?= /* @noEscape */ $name ?>-count: '<?= (int) $value ?>';
        <?php endforeach; ?>
    }
</style>
<?php endif; ?>
<script type="text/x-magento-init">
{
    "*": {
        "Swissup_Core/js/outdated-badge": <?= /* @noEscape */ $block->getJsonConfig() ?>
    }
}
</script>
